{
  "name": "Jellyfin Data Flow plugin",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspaces/jellyfin-data-flow-plugin",
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "forwardPorts": [8096],
  "portsAttributes": {
    "8096": { "label": "Jellyfin", "onAutoForward": "notify" }
  },
  "postCreateCommand": "bash scripts/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "editorconfig.editorconfig",
        "dbaeumer.vscode-eslint"
      ],
      "settings": {
        "dotnet.defaultSolution": "Jellyfin.Plugin.DataFlow.sln",
        "files.eol": "\n"
      }
    }
  },
  "remoteUser": "vscode"
}
