# Copy to .devcontainer/.env (gitignored) and adjust.
#
# Where the host's ~/.claude lives, as seen by whatever runs docker compose.
# Only needed when VS Code runs Dev Containers inside WSL
# (dev.containers.executeInWSL): there `~` is the WSL home rather than your
# Windows profile, so the mount silently becomes an empty root-owned directory
# and Claude Code cannot log in or write.
CLAUDE_HOST_HOME=/mnt/c/Users/<you>
